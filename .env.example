# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://leadmagnet:leadmagnet@localhost:5434/leadmagnet?schema=public"
# Separate database used by the API test suite (npm test)
DATABASE_URL_TEST="postgresql://leadmagnet:leadmagnet@localhost:5434/leadmagnet_test?schema=public"

# --- Session --------------------------------------------------------------
# Must be at least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-32-character-string-min"

# --- Seeded operator account (ADR 0002) ----------------------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin1234"

# --- Origins --------------------------------------------------------------
# Admin origin. Session cookies are scoped here.
APP_HOST="http://localhost:3000"
# Public form origin. MUST be a different origin from APP_HOST in production
# so that template HTML can never reach an admin cookie (ADR 0003).
FORM_HOST="http://localhost:3000"
